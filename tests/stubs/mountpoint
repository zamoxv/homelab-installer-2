#!/usr/bin/env bash
# Stub de 'mountpoint': siempre "no es punto de montaje" (exit 1). Ningún
# test necesita simular un disco ya montado.
set -uo pipefail
source "$(dirname "$0")/_stublib.sh"
log_call mountpoint "$@"
# STUB_MOUNTPOINTS="/ruta1 /ruta2": esas rutas SÍ son puntos de montaje.
last="${*: -1}"
[[ " ${STUB_MOUNTPOINTS:-} " == *" $last "* ]] && exit 0
exit 1
