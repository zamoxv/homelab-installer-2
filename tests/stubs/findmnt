#!/usr/bin/env bash
# Stub de 'findmnt': "/" -> la partición del disco de sistema
# ($LSBLK_SYSDISK1); cualquier otro punto de montaje (/boot, /boot/efi...)
# -> "no montado" (exit 1), igual que system_disks() ya tolera hosts BIOS
# sin ESP.
set -uo pipefail
source "$(dirname "$0")/_stublib.sh"
log_call findmnt "$@"

: "${LSBLK_SYSDISK:=/dev/sda}"

case "$*" in
  "-no SOURCE /")
    echo "${LSBLK_SYSDISK}1"
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
