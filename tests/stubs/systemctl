#!/usr/bin/env bash
# Stub de 'systemctl' (invocación directa, sin sudo): siempre "no
# disponible" (exit 1). Ningún módulo probado depende de systemd de verdad;
# los llamadores que importan (ver lib/services.sh, lib/dns.sh) ya toleran
# este resultado.
set -uo pipefail
source "$(dirname "$0")/_stublib.sh"
log_call systemctl "$@"
# STUB_TAILSCALED_UNIT=1: 'systemctl cat tailscaled.service' existe (Tailscale
# instalado como servicio); en cualquier otro caso, "no disponible".
if [[ "${1:-}" == "cat" && "${2:-}" == "tailscaled.service" && -n "${STUB_TAILSCALED_UNIT:-}" ]]; then
  echo "[Unit]"; exit 0
fi
exit 1
