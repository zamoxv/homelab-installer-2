#!/usr/bin/env bash
# Stub de 'docker' para tests: nunca toca un daemon real. Despacha por el
# subcomando/patrón de argumentos (igual que el stub de 'lsblk' descrito
# para datadisk: switch sobre "$*"). Todo lo no reconocido: éxito silencioso
# (exit 0), para no romper módulos que solo necesitan "docker existe/está
# vivo" sin importarles el detalle.
set -uo pipefail
source "$(dirname "$0")/_stublib.sh"
log_call docker "$@"

# STUB_DOCKER_FAIL_START=1: 'docker start' falla (p. ej. sudo sin caché).
# (STUB_DOCKER_FAIL_START=1 o una lista de nombres.)
if [[ -n "${STUB_DOCKER_FAIL_START:-}" && "${1:-}" == "start" ]]; then
  if [[ "$STUB_DOCKER_FAIL_START" == "1" || " $STUB_DOCKER_FAIL_START " == *" ${*: -1} "* ]]; then exit 1; fi
fi

# STUB_DOCKER_FAIL_STOP="all" o una lista de nombres: 'docker stop' falla para
# esos contenedores (simula un contenedor que no se deja detener).
if [[ -n "${STUB_DOCKER_FAIL_STOP:-}" && "${1:-}" == "stop" ]]; then
  last="${*: -1}"
  if [[ "$STUB_DOCKER_FAIL_STOP" == "all" || " $STUB_DOCKER_FAIL_STOP " == *" $last "* ]]; then
    exit 1
  fi
fi

# STUB_DOCKER_INSPECT_ERROR="a": 'inspect' falla con un error de docker (no es
# "no existe"); STUB_DOCKER_NOT_FOUND="a": falla con "No such object".
if [[ "${1:-}" == "inspect" ]]; then
  last="${*: -1}"
  if [[ " ${STUB_DOCKER_INSPECT_ERROR:-} " == *" $last "* ]]; then
    echo "permission denied while trying to connect to the Docker daemon socket" >&2; exit 1
  fi
  if [[ " ${STUB_DOCKER_NOT_FOUND:-} " == *" $last "* ]]; then
    echo "Error: No such object: $last" >&2; exit 1
  fi
fi
# STUB_RECOVERY_FILE: al hacer 'stop' registra si ese archivo ya existía.
if [[ "${1:-}" == "stop" && -n "${STUB_RECOVERY_FILE:-}" ]]; then
  printf 'recovery-at-stop\t%s\t%s\n' "${*: -1}" "$([[ -s "$STUB_RECOVERY_FILE" ]] && echo yes || echo no)" >> "$STUB_CALL_LOG"
fi
# STUB_DOCKER_START_IGNORED=N: los primeros N 'start' de cada contenedor
# devuelven 0 pero no lo levantan (un 'docker stop' viejo aún en curso).
# STUB_DOCKER_KILL_ON_START=1: el primer 'start' manda TERM al entrypoint
# (segunda señal en pleno cleanup).
if [[ "${1:-}" == "start" && -n "${STUB_DOCKER_STATE_DIR:-}" ]]; then
  last="${*: -1}"
  if [[ -n "${STUB_DOCKER_START_IGNORED:-}" ]]; then
    n=0; [[ -f "$STUB_DOCKER_STATE_DIR/.startcount.$last" ]] && n="$(cat "$STUB_DOCKER_STATE_DIR/.startcount.$last")"
    if (( n < STUB_DOCKER_START_IGNORED )); then echo $((n + 1)) > "$STUB_DOCKER_STATE_DIR/.startcount.$last"; exit 0; fi
  fi
  if [[ -n "${STUB_DOCKER_KILL_ON_START:-}" && ! -f "$STUB_DOCKER_STATE_DIR/.killed" ]]; then
    : > "$STUB_DOCKER_STATE_DIR/.killed"
    stub_kill_entrypoint || true
    sleep 0.3
  fi
fi

# STUB_DOCKER_NOT_RUNNING="a b": esos contenedores existen pero están
# detenidos ('inspect -f {{.State.Running}}' -> false). STUB_DOCKER_STATE_DIR:
# si existe, 'stop'/'start' lo reflejan en archivos para que un test pueda
# afirmar el estado FINAL de cada contenedor.
if [[ "${1:-}" == "inspect" && "$*" == *"State.Running"* ]]; then
  last="${*: -1}"
  if [[ " ${STUB_DOCKER_NOT_RUNNING:-} " == *" $last "* ]]; then
    echo "false"; exit 0
  fi
  if [[ -n "${STUB_DOCKER_STATE_DIR:-}" && -f "${STUB_DOCKER_STATE_DIR}/$last.stopped" ]]; then
    echo "false"; exit 0
  fi
fi
if [[ -n "${STUB_DOCKER_STATE_DIR:-}" ]]; then
  case "${1:-}" in
    stop) : > "${STUB_DOCKER_STATE_DIR}/${*: -1}.stopped"; exit 0 ;;
    start) rm -f "${STUB_DOCKER_STATE_DIR}/${*: -1}.stopped"; exit 0 ;;
  esac
fi

case "$*" in
  "run --rm -i httpd:2-alpine htpasswd -n -i -B -C 10 "*)
    # Lee y descarta la contraseña de stdin (igual que haría el htpasswd
    # real; acá no se usa para nada, el hash de la respuesta es fijo — lo
    # que importa para el test es que la contraseña NUNCA llegó por argv,
    # ver STUB_CALL_LOG). Sin leerla, el extremo escritor del pipe
    # ('printf ... | hli_docker run ...' en modules/adguard.sh) podría
    # quedar esperando.
    cat >/dev/null 2>&1 || true
    user="${@: -1}"
    # Hash Argon2id... no, bcrypt de mentira, con la forma REAL de
    # 'htpasswd -B' ($2y$<costo>$<22 salt + 31 hash>, base64 sin padding).
    # Terminado en '\n' PLANO (no '\r\n'): a diferencia del stub de
    # 'vaultwarden hash' de más abajo, acá 'docker run -i' (SIN '-t') no
    # asigna una pty, así que no hay traducción ONLCR que limpiar.
    printf '%s:$2y$10$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0\n' "$user"
    exit 0
    ;;
  "inspect -f "*"State.Running"*)
    echo "true"
    exit 0
    ;;
  "service inspect dokploy --format"*)
    echo "dokploy/dokploy:v1.2.3-test"
    exit 0
    ;;
  "service ls --filter"*"--format"*)
    echo "1/1"
    exit 0
    ;;
  "inspect "*)
    # Existencia del contenedor/servicio: siempre "sí existe" en estos
    # tests (los módulos de v2.3 no dependen de un estado "no instalado"
    # previo al deploy).
    exit 0
    ;;
  "info")
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
