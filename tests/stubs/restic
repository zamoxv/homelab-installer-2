#!/usr/bin/env bash
# Stub de 'restic' para tests: nunca toca un repositorio real. Registra el
# argv completo (log_call) y, en una línea aparte 'restic-env', QUÉ variables
# de entorno recibió (repositorio, archivo de contraseña y solo el LARGO de las
# claves de R2: así un test puede afirmar que el secreto jamás aparece en el
# log y, a la vez, que llegó por el entorno).
#
# Interruptores:
#   STUB_RESTIC_FAIL="copy backup:cloud ..."  subcomandos que fallan; para
#                    'backup' se puede filtrar por tag ('backup:cloud').
#   STUB_RESTIC_FAIL_RC                       código de salida (default 1).
#   STUB_RESTIC_SNAPSHOTS_FILE=<json>         lista de fotos de 'snapshots --json'
#                    (filtra por --tag y por un id/prefijo posicional); sin
#                    esto, el comportamiento histórico (STUB_RESTIC_HAS_FULL).
#   STUB_RESTIC_FIXTURE=<dir>                 contenido de las fotos: 'restore'
#                    copia <dir><ruta> a <target><ruta> por cada --include que
#                    exista ahí (lo que no está "no está en la foto").
#                    STUB_RESTIC_FIXTURE_R2 lo reemplaza para los repos s3.
#   STUB_RESTIC_CAT_WRONG_PW=1                'cat config' falla con "wrong password".
#   STUB_RESTIC_CAT_ERROR=1                   'cat config' de R2 falla por red (sin señal de "no hay repo").
#   STUB_RESTIC_KILL_ON="backup"              envía TERM al proceso bin/hli2-backup
#                    (el ancestro más alto) al correr ese subcomando: simula
#                    una interrupción en plena ventana de parada.
set -uo pipefail
source "$(dirname "$0")/_stublib.sh"
log_call restic "$@"

{
  printf 'restic-env\tREPO=%s\tPW_FILE=%s\tAWS_KEY_LEN=%s\tAWS_SECRET_LEN=%s\tREGION=%s\n' \
    "${RESTIC_REPOSITORY:-}" "${RESTIC_PASSWORD_FILE:-}" \
    "$(printf %s "${AWS_ACCESS_KEY_ID:-}" | wc -c | tr -d " ")" "$(printf %s "${AWS_SECRET_ACCESS_KEY:-}" | wc -c | tr -d " ")" "${AWS_DEFAULT_REGION:-}"
} >> "$STUB_CALL_LOG" 2>/dev/null || true

sub=""
for a in "$@"; do
  case "$a" in
    init|backup|copy|forget|check|cat|snapshots|restore|stats) sub="$a"; break ;;
  esac
done

tag=""
prev=""
for a in "$@"; do
  [[ "$prev" == "--tag" ]] && tag="$a"
  prev="$a"
done

key="$sub"
[[ "$sub" == "backup" && -n "$tag" ]] && key="backup:$tag"
fail=0
for f in ${STUB_RESTIC_FAIL:-}; do
  if [[ "$f" == "$sub" || "$f" == "$key" ]]; then fail=1; fi
done

# STUB_RESTIC_PROBE=<archivo>: en cada 'backup' copia ahí el archivo de estado
# tal como está en ese instante (para afirmar que dice 'running').
if [[ -n "${STUB_RESTIC_PROBE:-}" && "$sub" == "backup" ]]; then
  cat "${HLI2_BACKUP_STATE_DIR:-/nonexistent}/backup-status" > "$STUB_RESTIC_PROBE" 2>/dev/null || true
fi

if [[ -n "${STUB_RESTIC_KILL_ON:-}" && "$sub" == "${STUB_RESTIC_KILL_ON}" ]]; then
  stub_kill_entrypoint || true
  sleep 0.2
  exit 1
fi

if [[ "$fail" -eq 1 ]]; then
  echo "Fatal: stub restic: $sub falla (simulado)" >&2
  exit "${STUB_RESTIC_FAIL_RC:-1}"
fi

is_r2=0
[[ "${RESTIC_REPOSITORY:-}" == s3:* ]] && is_r2=1

case "$sub" in
  init)
    if [[ "$is_r2" -eq 1 ]]; then
      : > "${STUB_SAFE_ROOT:-/nonexistent}/r2-initialized"
    elif _stub_path_is_safe "${RESTIC_REPOSITORY:-}"; then
      mkdir -p "$RESTIC_REPOSITORY" && : > "$RESTIC_REPOSITORY/config"
    fi
    echo "created restic repository (stub)"
    ;;
  cat)
    if [[ -n "${STUB_RESTIC_CAT_WRONG_PW:-}" ]]; then
      echo "Fatal: wrong password or no key found" >&2
      exit 1
    fi
    if [[ "$is_r2" -eq 1 ]]; then
      if [[ -n "${STUB_RESTIC_CAT_ERROR:-}" ]]; then
        echo "Fatal: unable to open config file: dial tcp: lookup r2: no such host" >&2
        exit 1
      fi
      if [[ ! -f "${STUB_SAFE_ROOT:-/nonexistent}/r2-initialized" && -z "${STUB_RESTIC_R2_INITIALIZED:-}" ]]; then
        # Mensaje real de restic 0.16 ante una clave S3 inexistente (no hay repositorio).
        printf 'Fatal: unable to open config file: Stat: The specified key does not exist.\nIs there a repository at the following location?\n%s\n' "${RESTIC_REPOSITORY:-}" >&2
        exit 1
      fi
    fi
    ;;
  stats)
    # STUB_RESTIC_STATS_SIZE: tamaño total de la foto (bytes).
    echo "{\"total_size\":${STUB_RESTIC_STATS_SIZE:-1024},\"total_file_count\":1,\"snapshots_count\":1}"
    ;;
  snapshots)
    if [[ -n "${STUB_RESTIC_SNAPSHOTS_FILE:-}" ]]; then
      sid=""
      for a in "$@"; do
        [[ "$a" =~ ^[0-9a-f]{8,64}$ ]] && sid="$a"
      done
      jq --arg tag "$tag" --arg sid "$sid" \
        '[ .[] | select($tag == "" or (.tags | index($tag))) | select($sid == "" or (.id | startswith($sid)) or (.short_id | startswith($sid))) ]' \
        "$STUB_RESTIC_SNAPSHOTS_FILE"
      exit 0
    fi
    # STUB_RESTIC_HAS_FULL=1: ya existe una foto 'full' (sin esto, la primera
    # corrida hace la pasada previa en vivo).
    if [[ -n "${STUB_RESTIC_HAS_FULL:-}" ]]; then echo '[{"short_id":"ab12cd00"}]'; else echo '[]'; fi
    ;;
  restore)
    target="" includes=() prev=""
    for a in "$@"; do
      [[ "$prev" == "--target" ]] && target="$a"
      [[ "$prev" == "--include" ]] && includes+=("$a")
      prev="$a"
    done
    fx="${STUB_RESTIC_FIXTURE:-}"
    [[ "$is_r2" -eq 1 && -n "${STUB_RESTIC_FIXTURE_R2:-}" ]] && fx="$STUB_RESTIC_FIXTURE_R2"
    if [[ -z "$target" ]] || ! _stub_path_is_safe "$target"; then
      echo "Fatal: stub restic: --target fuera del scratch" >&2
      exit 1
    fi
    mkdir -p "$target"
    for p in "${includes[@]}"; do
      if [[ -n "$fx" && -e "$fx$p" ]]; then
        mkdir -p "$target$(dirname "$p")"
        cp -a "$fx$p" "$target$p"
      fi
    done
    echo "restoring snapshot (stub)"
    ;;
  backup)
    case "$tag" in
      warmup) echo "snapshot ab12cd03 saved" ;;
      full) echo "snapshot ab12cd01 saved" ;;
      cloud) echo "snapshot ab12cd02 saved" ;;
      *) echo "snapshot ab12cd99 saved" ;;
    esac
    ;;
esac
exit 0
