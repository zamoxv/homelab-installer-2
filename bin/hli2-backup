#!/usr/bin/env bash
# Entrada NO interactiva del backup (sin TTY ni dialog). La usan el servicio
# systemd hli2-backup.service, la herramienta backup-now y backup-setup, siempre
# como root y SIEMPRE desde la copia root-owned en /usr/local/lib/hli2 (la deja
# backup_refresh_install): root nunca ejecuta código de un checkout del usuario.
#
#   hli2-backup run [--no-retention]
#                        Backup completo (fotos locales + copia a R2 + retención).
#   hli2-backup init [--r2-assume-new]
#                        Inicializa los repositorios que falten (idempotente). Con R2
#                        ambiguo sale con código 20; --r2-assume-new (el usuario confirmó
#                        que el bucket es nuevo y está vacío) lo inicializa igual.
#   hli2-backup recover  Levanta lo que un backup interrumpido dejó detenido.
#   hli2-backup journal-recover
#                        Deshace un intercambio de restauración interrumpido, SIN
#                        docker (hli2-restore-journal.service, antes de Docker).
#   hli2-backup snapshots --source local|r2
#                        Lista las fotos restaurables (id y fecha, la más nueva
#                        primero) por stdout; no usa el log ni el bloqueo.
#   hli2-backup restore --source local|r2 --snapshot <id> --target <servicio|all>
#                        [--discard-old] [--with-restic-env]
#                        Restaura (ver lib/restore.sh). Los argumentos se
#                        validan de forma estricta: vienen del usuario.
#
# Registra en $LOG_DIR/backup.log (0640 root; sin secretos) y, si hay
# terminal, también la muestra.
set -euo pipefail

# Bajo systemd no hay $USER y lib/core.sh lo exige.
export USER="${USER:-root}"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$HERE/.." && pwd)"

# Guardia: todo lo que se va a sourcear debe ser de root y no escribible por
# otros (si no, es el mismo agujero que se evita con la copia root-owned).
# 'HLI2_BACKUP_EXPECT_UID' y 'HLI2_BACKUP_ALLOW_NONROOT' existen solo para los
# tests (corren como usuario normal con restic/docker/sudo simulados).
_expect_uid="${HLI2_BACKUP_EXPECT_UID:-0}"
_bad=""
for _f in "$ROOT_DIR" "$HERE" "$ROOT_DIR/lib" "$ROOT_DIR/services" "$ROOT_DIR/config" \
          "$HERE"/* "$ROOT_DIR"/lib/* "$ROOT_DIR"/services/* "$ROOT_DIR"/config/*; do
  [[ -e "$_f" ]] || continue
  read -r _uid _mode < <(stat -c '%u %a' -- "$_f")
  if [[ "$_uid" != "$_expect_uid" ]]; then _bad="$_f"; break; fi
  if [[ "$_expect_uid" == "0" ]] && (( 8#$_mode & 8#022 )); then _bad="$_f"; break; fi
done
if [[ -n "$_bad" ]]; then
  echo "ERROR: $_bad no es de root o es escribible por otros: hli2-backup solo corre desde la copia root-owned (ejecute backup-setup)." >&2
  exit 1
fi

source "$ROOT_DIR/lib/core.sh"

if [[ "$(id -u)" -ne 0 && -z "${HLI2_BACKUP_ALLOW_NONROOT:-}" ]]; then
  echo "ERROR: hli2-backup debe correr como root (use sudo)." >&2
  exit 1
fi

_usage() {
  echo "Uso: hli2-backup {run [--no-retention]|init [--r2-assume-new]|recover|journal-recover|snapshots --source local|r2|restore --source local|r2 --snapshot <id> --target <servicio|all>}" >&2
  exit 2
}
case "${1:-}" in
  run|recover|journal-recover|init|restore|snapshots) ;;
  *) _usage ;;
esac

umask 027
# 'snapshots' imprime su resultado por stdout para que el módulo lo capture: sin
# redirección al log (no escribe nada en disco, ni toma el bloqueo).
if [[ "$1" == "snapshots" ]]; then
  restore_snapshots_main "${@:2}"
  exit $?
fi

mkdir -p "$LOG_DIR"
if [[ -t 1 ]]; then
  exec > >(tee -a "$LOG_DIR/backup.log") 2>&1
else
  exec >>"$LOG_DIR/backup.log" 2>&1
fi

# Una terminal SSH colgada rompe la tubería de 'tee': un SIGPIPE no puede matar el
# proceso (menos aún antes del cleanup que vuelve a iniciar los contenedores).
trap '' PIPE

# Argumentos de cada subcomando, validados ANTES de tocar nada.
case "$1" in
  run)
    for _a in "${@:2}"; do
      case "$_a" in
        --no-retention) BK_NO_RETENTION=1 ;;
        *) echo "ERROR: argumento no reconocido para run: $(printf '%q' "$_a")" >&2; exit 2 ;;
      esac
    done
    ;;
  restore)
    restore_parse_args "${@:2}" || exit 2
    ;;
  init)
    for _a in "${@:2}"; do
      case "$_a" in
        --r2-assume-new) BK_R2_ASSUME_NEW=1 ;;
        *) echo "ERROR: argumento no reconocido para init: $(printf '%q' "$_a")" >&2; exit 2 ;;
      esac
    done
    ;;
  *)
    [[ $# -eq 1 ]] || _usage
    ;;
esac

if ! _backup_state_dir_ensure; then
  echo "ERROR: $BK_MSG" >&2
  exit 1
fi

# Un solo proceso a la vez (timer + manual, o ExecStopPost): sin esto, el
# 'recover' de uno levantaría contenedores que el otro detuvo a propósito.
exec 9>"$BACKUP_STATE_DIR/lock"
# Si hay otro proceso (el timer y 'recover' al arrancar pueden coincidir), se
# espera un rato en vez de fallar sin dejar rastro.
if [[ "$1" == "recover" || "$1" == "journal-recover" ]]; then _wait="${HLI2_BACKUP_LOCK_WAIT:-30}"; else _wait="${HLI2_BACKUP_LOCK_WAIT:-120}"; fi
if ! flock -w "$_wait" 9; then
  echo "Otro backup o restauración mantiene el bloqueo desde hace más de ${_wait} s."
  if [[ "$1" == "journal-recover" ]]; then
    # En el arranque, sin el bloqueo no se pudo deshacer nada: la unidad tiene que
    # fallar de forma visible (no "éxito" con el dato sin devolver).
    echo "ERROR: no se pudo tomar el bloqueo: la restauración interrumpida NO se revirtió." >&2
    exit 1
  fi
  if [[ "$1" == "restore" ]]; then
    RS_RESULT=error RS_MODULES="" RS_STIME=""
    RS_MSG="no se pudo iniciar: otro backup o restauración mantiene el bloqueo"
    _restore_status_write || true
    exit 1
  fi
  if [[ "$1" == "run" ]]; then
    if [[ "$(restore_status_get result)" == "running" ]]; then
      # El bloqueo lo tiene una restauración (puede ser larga): no es un error del
      # backup. El servicio termina bien y el próximo backup corre cuando termine.
      # El estado NO refresca la fecha del último intento real (el aviso de "más de
      # N horas" sigue valiendo) ni pisa su resultado (un error previo sigue siendo
      # un error): solo anota 'last_skip' y lo agrega al mensaje.
      BK_RESULT="$(backup_status_get result)"; [[ -n "$BK_RESULT" ]] || BK_RESULT=skipped
      # Un 'running' viejo es de un backup que murió: no se reescribe como en curso.
      [[ "$BK_RESULT" != "running" ]] || BK_RESULT=interrupted
      BK_LOCAL="$(backup_status_get local)"; [[ -n "$BK_LOCAL" ]] || BK_LOCAL=skipped
      BK_CLOUD="$(backup_status_get cloud)"; [[ -n "$BK_CLOUD" ]] || BK_CLOUD=skipped
      BK_CHECK="$(backup_status_get check)"; [[ -n "$BK_CHECK" ]] || BK_CHECK=skipped
      BK_ID_FULL="$(backup_status_get snapshot_full)" BK_ID_CLOUD="$(backup_status_get snapshot_cloud)"
      BK_TS="$(backup_status_get timestamp)"
      BK_LAST_SKIP="$(date -Is)"
      BK_MSG="$(backup_status_get message)"
      if [[ "$BK_MSG" != *"último intento omitido"* ]]; then
        BK_MSG="${BK_MSG:+$BK_MSG; }último intento omitido: restauración en curso"
      fi
      _backup_status_write || true
      exit 0
    fi
    BK_RESULT=error BK_LOCAL=skipped BK_CLOUD=skipped BK_CHECK=skipped BK_ID_FULL="" BK_ID_CLOUD=""
    BK_MSG="no se pudo iniciar: otro backup mantiene el bloqueo"
    _backup_status_write || true
    exit 1
  fi
  exit 0
fi

case "$1" in
  run)
    # Lo detenido se levanta SIEMPRE: salida normal, error de 'set -e' o señal.
    trap backup_exit_cleanup EXIT
    trap 'exit 143' TERM
    trap 'exit 130' INT HUP
    backup_run
    ;;
  journal-recover)
    # Sin docker: solo devuelve a su lugar lo que una restauración dejó a medias.
    restore_journal_recover_main
    ;;
  recover)
    trap backup_exit_cleanup EXIT
    backup_status_mark_stale || true
    restore_status_mark_stale || true
    backup_recover
    ;;
  restore)
    # Igual que 'run': lo detenido se levanta SIEMPRE (salida normal, error o señal).
    trap restore_exit_cleanup EXIT
    trap 'exit 143' TERM
    trap 'exit 130' INT HUP
    restore_run
    ;;
  init)
    backup_init
    ;;
esac
